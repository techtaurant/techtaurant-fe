{
  "name": "techtaurant-fe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "setup:https": "sh scripts/setup-local-https.sh",
    "dev:https": "node scripts/start-local-https.mjs",
    "start:https": "pnpm build && NODE_ENV=production node scripts/start-local-https.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "pnpm run api:generate && opennextjs-cloudflare build",
    "cf:preview": "pnpm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "pnpm run cf:build && opennextjs-cloudflare deploy --env=\"\"",
    "cf:deploy:dev": "pnpm run cf:build && opennextjs-cloudflare deploy --env dev",
    "cf:upload": "pnpm run cf:build && opennextjs-cloudflare upload --env=\"\"",
    "cf:upload:dev": "pnpm run cf:build && opennextjs-cloudflare upload --env dev",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "api:generate": "orval --config orval.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@tanstack/react-query": "^5.100.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.16.0",
    "markdown-it": "^14.3.0",
    "motion": "^12.40.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "overlay-kit": "^1.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@next/env": "^16.3.4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^17.0.4",
    "orval": "^8.9.1",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "wrangler": "^4.110.0"
  }
}
